meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refresh_token}}"
  }
}

docs {
  Exchange refresh token for new access token.
  
  Request Body:
  - refreshToken (required): JWT refresh token
  
  Response: AuthResponse with new accessToken and refreshToken
}
