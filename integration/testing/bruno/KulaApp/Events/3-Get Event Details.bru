meta {
  name: Get Event Details
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/events/{{event_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Retrieve specific event details.
  
  Path Parameters:
  - eventId (required): UUID of the event
  
  Response: EventResponse with full event details
}
