meta {
  name: Update Event
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/events/{{event_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "title": "Doctor Appointment - Updated",
    "description": "Annual checkup with Dr. Smith",
    "startTime": "2025-12-15T14:00:00Z",
    "endTime": "2025-12-15T15:00:00Z",
    "assignedTo": "{{assigned_user_id}}"
  }
}

docs {
  Update a calendar event.
  Only event creator or tenant owner can update.
  
  Path Parameters:
  - eventId (required): UUID of the event
  
  Request Body:
  - title (optional): Event title
  - description (optional): Event description
  - startTime (optional): ISO 8601 datetime
  - endTime (optional): ISO 8601 datetime
  - assignedTo (optional): UUID of tenant member
  
  Response: EventResponse with updated details
}
