meta {
  name: List Invitations
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/tenants/{{tenant_id}}/invitations?status={{status}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Owner retrieves all invitations for their tenant.
  
  Path Parameters:
  - tenantId (required): UUID of the tenant
  
  Query Parameters:
  - status (optional): Filter by status (Pending, Accepted, Expired, Revoked)
  
  Response: Array of InvitationResponse
}
