meta {
  name: List Tenant Members
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/tenants/{{tenant_id}}/members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Retrieve all members of a tenant.
  
  Path Parameters:
  - tenantId (required): UUID of the tenant
  
  Response: Array of TenantMemberResponse
}
